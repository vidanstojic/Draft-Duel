# Copy to keystore.properties (git-ignored) and fill in. Use forward slashes in Windows paths.
# Create the upload key once in Android Studio: Build > Generate Signed App Bundle > Create new,
# or with: keytool -genkeypair -v -keystore draft-duel-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Keep the .jks file and both passwords outside the repo and backed up: every later update must be
# signed with the same upload key (Play App Signing can reset a lost upload key, but it takes days).
storeFile=C:/Users/<you>/keys/draft-duel-upload.jks
storePassword=
keyAlias=upload
keyPassword=
